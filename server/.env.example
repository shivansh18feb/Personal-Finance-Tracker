# Production Environment Variables

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finance_tracker_pro?retryWrites=true&w=majority

# JWT Signing Secret (Generate with openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Server Port
PORT=8080

# Optional Mail Service (SMTP)
MAIL_HOST=smtp.gmail.com
